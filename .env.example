# Runtime mode remains explicit in every API request. This value only drives UI defaults.
LLMOPS_DEFAULT_MODE=simulation
LLMOPS_CAPTURE_CONTENT=false
LLMOPS_SLOW_TOOL_DELAY_SECONDS=1.2
LLMOPS_DATA_ROOT=./data

# Required only for live mode.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_NAME=policy-agent
FOUNDRY_AGENT_VERSION=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Required only for the live SRE / Observability investigation workflow.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
SRE_AGENT_NAME=
SRE_AGENT_ENDPOINT=https://<agent-endpoint>.azuresre.ai
AZURE_MONITOR_ACCOUNT_ID=/subscriptions/<subscription>/resourceGroups/<rg>/providers/Microsoft.Monitor/accounts/<workspace>
OBSERVABILITY_AGENT_NAME=
LLMOPS_OPERATIONS_POLL_INTERVAL_SECONDS=1
LLMOPS_OPERATIONS_POLL_TIMEOUT_SECONDS=120

# Set automatically in Azure Container Apps. Leave empty locally.
AZURE_EXECUTION_ENVIRONMENT=
AZURE_CLIENT_ID=

# Optional locally. Azure resources inject this at runtime.
APPLICATIONINSIGHTS_CONNECTION_STRING=
